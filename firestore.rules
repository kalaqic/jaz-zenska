rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Public (no auth) ---

    // Consultation: anyone can read available slots (booking form). Writes only from backend (Admin SDK).
    match /consultationSlots/{slotId} {
      allow read: if true;
      allow write: if false;
    }

    // --- Backend-only (no client access; your Vercel API uses Admin SDK and bypasses these rules) ---

    match /bookedConsultations/{docId} {
      allow read, write: if false;
    }

    match /waiting_payments/{docId} {
      allow read, write: if false;
    }

    // --- Authenticated users only ---

    // Users: each user can read and write only their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Dashboard: events (calendar) – logged-in users can read and write
    match /events/{eventId} {
      allow read, write: if request.auth != null;
    }

    // Courses and webinars – logged-in users can read
    match /courses/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /webinars/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // User progress (course progress) – logged-in users can read/write their own data
    match /userProgress/{docId} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
